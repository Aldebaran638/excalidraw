    {
      "id": "ogvvU9mQoSwFLFy9mpGjR",
      "type": "text",
      "x": 1909.6035173843397,
      "y": 5209.353022637876,
      "width": 425.1400146484375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
